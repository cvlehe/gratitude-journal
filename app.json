{
  "expo": {
    "name": "gratitude-journal",
    "slug": "gratitude-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/adaptive-icon-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vonlehec.gratitudejournal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "backgroundColor": "#F5F3E6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vonlehec.gratitudejournal",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bbed0f93-7e5c-43a0-96b0-223375abfc39"
      }
    },
    "plugins": [
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your private Gratitude Journal."
        }
      ]
    ]
  }
}
